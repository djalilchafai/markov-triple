import Mathlib
import MarkovTriple.BGL.FormData
import MarkovTriple.Hilbert.Existence

/-!
# The semigroup `P_t` and the generator `L` of a Diffusion Markov Triple (BGL D7, D9)
-/

open MeasureTheory
open scoped NNReal LinearPMap

namespace MarkovTriple.BGL

variable {E : Type*} [MeasurableSpace E]

/-- The **symmetric semigroup** `P = (P_t)_{t ≥ 0}` of the triple (BGL D9, §3.1.4–3.1.6): the
semigroup `e^{tL}` of contractions of `L²(μ)` generated by the Friedrichs extension `L` of
`L|𝒜₀` (the operator `f ↦ -L f` on classes of `𝒜₀` is densely defined, symmetric and nonnegative
by D3, D5, D6, `BGL/FormData.lean`).  It is positivity preserving and sub-Markov (theorems, not
part of this definition). -/
noncomputable def DiffusionTriple.semigroup (T : DiffusionTriple E) :
    ℝ≥0 → (Lp ℝ 2 T.μ →L[ℝ] Lp ℝ 2 T.μ) :=
  (DiffusionTriple.formData T).semigroup

/-- The **generator** `L` of the triple (BGL D7): the self-adjoint operator on `L²(μ)` with domain
`𝒟(L)`, the Friedrichs extension of `L|𝒜₀` (`𝒜₀ ⊂ 𝒟(L) ⊂ 𝒟(ℰ)`).  It is the generator of
`DiffusionTriple.semigroup`: `Hilbert.FormData.tendsto_generator_iff`; self-adjointness:
`Hilbert.FormData.generator_selfAdjoint`; it extends `L|𝒜₀`: `Hilbert.FormData.generator_extends`.
The book's `𝒟(L) = {f ∈ 𝒟(ℰ) : ∃ C, |ℰ(f,g)| ≤ C ‖g‖₂ ∀ g ∈ 𝒟(ℰ)}` is the standard
characterisation of the Friedrichs domain. -/
noncomputable def DiffusionTriple.generator (T : DiffusionTriple E) : Lp ℝ 2 T.μ →ₗ.[ℝ] Lp ℝ 2 T.μ :=
  (DiffusionTriple.formData T).generator

end MarkovTriple.BGL
